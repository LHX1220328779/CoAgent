COAGENT_API_KEY=replace-with-a-local-random-secret
COAGENT_PORT=4310
COAGENT_DB=.coagent/state.db
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=replace-with-another-local-secret
LITELLM_URL=http://127.0.0.1:4000/v1
LITELLM_MASTER_KEY=sk-replace-with-a-local-random-secret
# Default mock mode never contacts a paid provider.
COAGENT_MODE=mock
COAGENT_CONCURRENCY=2

# Arena Agent web-session research mode (no paid inference API required).
# COAGENT_MODE=arena
# ARENA_BRIDGE_URL=http://127.0.0.1:20140/v1
# ARENA_BRIDGE_KEY=local-bridge-secret-not-an-arena-api-key
# ARENA_SESSION_BINDINGS=.coagent/arena-sessions.json
# COAGENT_ALLOW_SIMULATED_TOOLS=1
# Optional local byte budget; this is not a verified Arena model context limit.
# ARENA_CONTEXT_BUDGET_BYTES=65536
# Optional private response capture for protocol troubleshooting; normally leave unset.
# COAGENT_ARENA_DEBUG_DIR=.coagent/arena-responses
# Local console; repeated launches reuse this window's service.
# COAGENT_CONSOLE_PORT=4312
