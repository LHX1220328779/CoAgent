{
  "name": "coagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.ts serve",
    "coagent": "node --env-file-if-exists=.env src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:all": "npm run check && npm test && npm run test:integration"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@types/node": "24.10.1",
    "opencode-ai": "1.19.5",
    "typescript": "5.9.3"
  }
}
